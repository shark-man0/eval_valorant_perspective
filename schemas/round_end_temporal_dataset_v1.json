        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "physical_event_key": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "physical_identity_verified": {
            "type": "boolean"
          },
          "window": {
            "type": "object",
            "properties": {
              "start_tick": {
                "type": "integer",
                "minimum": 0
              },
              "end_tick": {
                "type": "integer",
                "minimum": 0
              },
              "time_base": {
                "type": "string",
                "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
              }
