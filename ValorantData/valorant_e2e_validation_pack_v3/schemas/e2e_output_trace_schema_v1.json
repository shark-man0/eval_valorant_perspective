{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e_output_trace_schema_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events",
    "state_intervals",
    "ownership_intervals",
    "snapshots",
    "visual_observations",
    "temporal_features"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "round_id",
          "type",
          "actor",
          "time_sec"
        ],
        "properties": {
          "round_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "time_sec": {
            "type": "number",
            "minimum": 0
          },
          "attributes": {
            "type": "object"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "state_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "round_id",
          "state",
          "interval"
        ],
        "properties": {
          "round_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "interval": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "ownership_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "round_id",
          "owner",
          "interval"
        ],
        "properties": {
          "round_id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "interval": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "round_id",
          "time_sec"
        ],
        "properties": {
          "round_id": {
            "type": "string"
          },
          "time_sec": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "hud_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visual_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "map_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "visual_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "round_id",
          "observation",
          "actor",
          "time_sec"
        ],
        "properties": {
          "round_id": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "time_sec": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "temporal_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "feature",
          "interval"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "interval": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "value": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
