{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "callout_registry_schema_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "map_id",
    "vocabulary_status",
    "location_label_policy",
    "records"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "map_id": {
      "type": "string"
    },
    "vocabulary_status": {
      "type": "string"
    },
    "location_label_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_duration_sec",
        "exact_match_base_confidence",
        "fuzzy_match_min",
        "confidence_rule",
        "on_unknown"
      ],
      "properties": {
        "stable_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exact_match_base_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fuzzy_match_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_rule": {
          "type": "string"
        },
        "on_unknown": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "verification_status",
          "confidence_cap",
          "aliases",
          "notes"
        ],
        "properties": {
          "zone_id": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "observed_user_material",
              "public_vocab_unobserved",
              "provisional_needs_observation"
            ]
          },
          "confidence_cap": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}