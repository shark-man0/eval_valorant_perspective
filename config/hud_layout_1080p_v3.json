    "unknown_below": 0.65,
    "temporal_debounce_frames": 2,
    "require_two_source_agreement_for": [
      "player_death",
      "spike_planted",
      "round_boundary",
      "kill_side_assignment"
    ],
    "relationship_to_final_evaluation": {
      "final_ai_coach_thresholds_source": "valorant_codex_ready_bundle_v3/CODEX_MASTER_SPEC.md section 11",
      "note": "HUD thresholds decide whether an observation/fact is trustworthy enough to emit. Final evaluation thresholds 0.55/0.75 decide whether an AI Coach evaluation is shown. They are intentionally different layers.",
      "fact_confidence_rule": "derived fact confidence is the minimum confidence of required observations/sources after cross-check; do not remap HUD confidence to the final-evaluation scale."
    }
