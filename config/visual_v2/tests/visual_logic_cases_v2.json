{
  "version": "2.0",
  "cases": [
    {
      "id": "VA-001",
      "name": "ammo delta + recoil => shot",
      "inputs": {
        "hud_state": "live_first_person",
        "ammo_delta": -1,
        "recoil_score": 0.86
      },
      "expected": {
        "event": "shot",
        "status": "confirmed"
      }
    },
    {
      "id": "VA-002",
      "name": "ammo change in buy menu is not a shot",
      "inputs": {
        "hud_state": "buy_menu_open",
        "ammo_delta": 12,
        "recoil_score": 0.05
      },
      "expected": {
        "event": "shot",
        "status": "suppressed"
      }
    },
    {
      "id": "VA-003",
