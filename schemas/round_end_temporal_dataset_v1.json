        "evaluation_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "developer_id": {
          "type": "string",
          "minLength": 1
        },
        "frozen_order": {
          "type": "integer",
          "minimum": 0
        },
        "reference_parent_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_profile_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "assets_manifest_path": {
          "type": [
            "string",
            "null"
          ]
