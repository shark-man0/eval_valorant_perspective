          "source_id",
          "event_id",
          "window",
          "kind",
          "order",
          "evidence_id",
          "actor_id",
          "recorded_at",
          "code_sha256",
          "profile_sha256",
          "assets_sha256",
          "notes"
        ],
        "additionalProperties": false
      }
