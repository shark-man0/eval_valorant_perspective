              {
                "type": "null"
              }
            ]
          },
          "sealed_reserved": {
            "type": "boolean"
          },
          "preflight_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "preflight_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
